% Logical objects: inherited self sends use the receiver's overridden policy.
agent explorer {
    class RoutePolicy {
        slot destination.

        method candidateFrom: From to: To {
            at(From).
            path(From, To).
        }
        method mayMoveFrom: From to: To {
            [self candidateFrom: From to: To].
            clear(To).
        }
        method finished {
            at(@destination).
        }
    }

    class ApprovedPolicy extends RoutePolicy {
        slot permission.

        method candidateFrom: From to: To {
            at(From).
            path(From, To).
            approved(To, @permission).
        }
    }

    object relaxed : RoutePolicy {
        destination = goal.
    }
    object cautious : ApprovedPolicy {
        destination = goal.
        permission = reviewed.
    }

    belief at(start).
    belief path(start, bridge).
    belief path(bridge, goal).
    belief path(start, forest).
    belief path(forest, goal).
    belief approved(forest, reviewed).
    belief approved(goal, reviewed).

    goal [cautious finished].

    plan inspect_and_move(From, To) for [cautious finished] {
        when [cautious candidateFrom: From to: To], unknown(clear(To)).
        suppose(clear(To)) { prove([cautious mayMoveFrom: From to: To]). }
        observe clear(To).
        require [cautious mayMoveFrom: From to: To].
        act move(From, To).
    }
}
